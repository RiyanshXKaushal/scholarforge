# Paste these into Streamlit Cloud -> your app -> Settings -> Secrets.
# Never commit a real secrets.toml to GitHub.
GEMINI_API_KEY = "paste-from-aistudio.google.com"
GEMINI_MODEL = "gemini-flash-latest"   # change to any Flash model listed in Google AI Studio

# Telegram digest (recommended): the app messages you directly after every run.
TELEGRAM_BOT_TOKEN = "from @BotFather"
TELEGRAM_CHAT_ID = "your numeric ID from @userinfobot"

# Optional
GITHUB_TOKEN = "fine-grained token with no extra permissions; raises the GitHub rate limit"
# N8N_WEBHOOK_URL = "only if you route the digest through n8n instead"
